# Copier ce fichier en .env.local (développement) et renseigner les mêmes variables
# dans Netlify : Site configuration → Environment variables.
# Aucune de ces valeurs n'est secrète : la clé « publishable » est conçue pour le navigateur
# et les accès sont limités par les politiques RLS de la base.
# Ne JAMAIS ajouter ici la clé secrète (sb_secret_… / service_role).

# Supabase → Project Settings → API (ou bouton « Connect »)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique du site, sans « / » final (balises canoniques, sitemap).
# Facultatif sur Netlify (la variable URL fournie par Netlify est utilisée par défaut).
NEXT_PUBLIC_SITE_URL=
